# Base URL of the API service. The worker polls apps/api for queued jobs
# and reports progress/results back to it over HTTP; it never talks to the
# database or object storage directly except through the shared local
# filesystem when STORAGE_PROVIDER=local (see storageLocalRoot below).
API_BASE_URL=http://localhost:4100

# Must match the API's WORKER_SHARED_SECRET.
WORKER_SHARED_SECRET=dev-worker-secret-change-me

WORKER_POLL_INTERVAL_SEC=2

# "cpu" or "cuda". CPU works everywhere (required for local dev without a
# GPU); CUDA substantially accelerates Demucs separation and Whisper
# transcription when an NVIDIA GPU + matching PyTorch build are available.
PROCESSING_DEVICE=cpu

# faster-whisper model size: tiny, base, small, medium, large-v3. Larger
# models are more accurate but slower and use more memory; "base" is a
# reasonable CPU-friendly default for development.
WHISPER_MODEL_SIZE=base

# "demucs" for real vocal/instrumental separation (downloads model weights
# on first use, then runs from local cache), or "none" to skip separation
# honestly (the UI will show "isolated vocals unavailable" instead of
# faking a separated track).
SEPARATION_ENGINE=demucs

WORKER_TMP_DIR=./worker_tmp
