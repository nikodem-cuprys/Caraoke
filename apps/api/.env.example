NODE_ENV=development
PORT=4100
# Absolute origin the API is reachable at. Used to turn the local storage
# provider's signed asset paths into absolute URLs (the browser and worker
# resolve relative URLs against their own origin, not the API's).
API_PUBLIC_URL=http://localhost:4100

# --- Database ---
# Dev default: zero-infra SQLite. For Postgres (see docker-compose.yml),
# set DATABASE_PROVIDER=postgresql and point DATABASE_URL at your instance,
# then re-run `npx prisma migrate dev` once against prisma/schema.prisma
# with its datasource provider switched to "postgresql".
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# --- Object storage ---
# Dev default: local filesystem, served (signed, time-limited) by the API's
# own /assets route. For S3/MinIO, set STORAGE_PROVIDER=s3 and fill in the
# S3_* vars below (see docker-compose.yml for a local MinIO instance).
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage_data
# S3_BUCKET=singlearn
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=singlearn
# AWS_SECRET_ACCESS_KEY=singlearn-secret

# --- Job queue ---
# Dev default: the ProcessingJob table itself is the queue (no Redis
# needed). For BullMQ (multi-worker/GPU scaling), set QUEUE_PROVIDER=bullmq
# and REDIS_URL (see docker-compose.yml for a local Redis instance).
QUEUE_PROVIDER=db
REDIS_URL=

# --- Worker auth ---
# Shared secret the worker sends on internal/* callbacks. Change this in
# any shared/production environment.
WORKER_SHARED_SECRET=dev-worker-secret-change-me

# --- Cost/abuse limits ---
MAX_UPLOAD_MB=60
MAX_SONG_DURATION_SEC=480
MAX_CONCURRENT_JOBS=2

# --- CORS ---
CORS_ORIGIN=http://localhost:3200,http://localhost:3000

# --- YouTube metadata ---
YOUTUBE_OEMBED_TIMEOUT_MS=8000

# --- Pipeline ---
# Informational default surfaced to the frontend before a song is
# processed; the worker's own SEPARATION_ENGINE env var is authoritative
# for what actually runs.
SEPARATION_ENGINE=demucs

# Signs the local-storage asset URLs (HMAC-SHA256). Change this in any
# shared/production environment.
ASSET_SIGNING_SECRET=dev-asset-signing-secret-change-me
